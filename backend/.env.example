# Copy to .env and fill in. .env is git-ignored.

# --- HTTP server ---
SAUTH_HTTP_ADDR=:8080
SAUTH_ENV=development

# --- Database (connect as the least-privilege app role) ---
SAUTH_DATABASE_URL=postgres://sauth_app:sauth_dev_pw@localhost:5432/sauth?sslmode=disable

# --- Access-token (JWT) signing ---
# generate: openssl rand -base64 48   (or: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256})) )
SAUTH_JWT_SECRET=replace-with-a-long-random-string
SAUTH_JWT_ISSUER=sauth

# --- Fallback token lifetimes (per-project values in DB win) ---
SAUTH_ACCESS_TOKEN_TTL=15m
SAUTH_REFRESH_TOKEN_TTL=720h

# --- AES-GCM key for encrypting provider secrets at rest (32 bytes, base64) ---
# generate: openssl rand -base64 32
SAUTH_ENCRYPTION_KEY=replace-with-32-bytes-base64

# --- Outbound email (OTP / verification / password reset) ---
SAUTH_SMTP_HOST=
SAUTH_SMTP_PORT=587
SAUTH_SMTP_USERNAME=
SAUTH_SMTP_PASSWORD=
SAUTH_MAIL_FROM=no-reply@yourauth.dev

# --- SMS provider (phone OTP) — filled in when that flow lands ---
SAUTH_SMS_PROVIDER=
SAUTH_SMS_API_KEY=

# --- Google OAuth ---
# Per-project client id/secret are configured through the console and stored
# (encrypted) in the projects table; no platform-wide value needed here.
